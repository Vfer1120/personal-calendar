NODE_ENV=production
APP_URL=https://your-project.vercel.app
BETTER_AUTH_URL=https://your-project.vercel.app
CORS_ORIGIN=https://your-project.vercel.app
PORT=3000
DATABASE_URL=postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-one-time-setup-token
OWNER_EMAIL=you@example.com
ALLOW_MULTI_USER=true
REGISTRATION_INVITE_CODE=replace-with-a-private-invite-code
CRON_SECRET=replace-with-a-long-random-cron-secret
DB_POOL_MAX=2
S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=calendar-attachments
S3_ACCESS_KEY=replace-with-supabase-storage-access-key
S3_SECRET_KEY=replace-with-supabase-storage-secret-key
ATTACHMENT_MASTER_KEY=replace-with-existing-32-byte-base64-key
MAX_ATTACHMENT_MB=25
SMTP_URL=smtps://your-mailbox%40example.com:authorization-code@smtp.example.com:465
SMTP_FROM=个人日程 <your-mailbox@example.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-mailbox@example.com
DEFAULT_TIMEZONE=Asia/Shanghai
DEMO_MODE=false
AI_ENABLED=true
AI_PROVIDER=zhipu
AI_API_KEY=replace-with-zhipu-key
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_TEXT_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-flash
AI_REQUEST_TIMEOUT_MS=50000
AI_MAX_IMAGE_MB=10
AI_MAX_IMAGES=3
AI_PRIVATE_DAILY_LIMIT=30
AI_DEMO_DAILY_LIMIT=3