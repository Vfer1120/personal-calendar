{
  "name": "personal-calendar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format:check": "prettier --check .",
    "vercel-build": "pnpm --filter @calendar/web build && node scripts/copy-web-dist.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}