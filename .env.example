NODE_ENV=development
DOMAIN=localhost
POSTGRES_PASSWORD=calendar
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BOOTSTRAP_TOKEN=replace-with-a-one-time-setup-token
OWNER_EMAIL=you@example.com
ALLOW_MULTI_USER=false
REGISTRATION_INVITE_CODE=
CRON_SECRET=
DB_POOL_MAX=10
CORS_ORIGIN=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=calendar-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
ATTACHMENT_MASTER_KEY=replace-with-32-byte-base64-key
MAX_ATTACHMENT_MB=25
SMTP_URL=
SMTP_FROM=Calendar <calendar@example.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
DEFAULT_TIMEZONE=Asia/Shanghai
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
DEMO_MODE=false
DEMO_ACCESS_PASSWORD=replace-with-a-demo-invite-password
DEMO_SESSION_TTL_HOURS=24

AI_ENABLED=false
AI_PROVIDER=zhipu
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_TEXT_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-flash
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_IMAGE_MB=10
AI_MAX_IMAGES=3
AI_PRIVATE_DAILY_LIMIT=30
AI_DEMO_DAILY_LIMIT=3
